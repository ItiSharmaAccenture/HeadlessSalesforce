# ---------------------------------------------------------------------------
# Salesforce AI Sales Assistant - example configuration
#
# Copy to .env.local and fill in. .env.local is git-ignored.
# Never prefix a secret with NEXT_PUBLIC_: that would ship it to the browser.
# ---------------------------------------------------------------------------

# --- Google Gemini ---------------------------------------------------------
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Leave blank to use `gemini-flash-latest`, an alias that tracks the current
# free-tier Flash model. Pin a specific model here if you prefer.
GEMINI_MODEL=gemini-flash-latest

# --- Salesforce OAuth ------------------------------------------------------
# Consumer Key from the External Client App.
SALESFORCE_CLIENT_ID=

# Consumer Secret. Leave blank when the External Client App is configured as a
# public client using PKCE (recommended for this localhost POC).
SALESFORCE_CLIENT_SECRET=

# https://login.salesforce.com for production and Developer Edition orgs,
# https://test.salesforce.com for sandboxes, or your My Domain login URL.
SALESFORCE_LOGIN_URL=https://login.salesforce.com

# Must match the External Client App callback URL character for character.
SALESFORCE_REDIRECT_URI=http://localhost:3000/api/auth/callback/salesforce

# Space- or comma-separated. mcp_api is required; refresh_token keeps the
# dedicated user authorized without repeating the setup flow.
# `api` is required by the My Day dashboard (Named Query + REST). Add it to the
# External Client App's OAuth scopes too, then re-run the one-time authorization.
SALESFORCE_SCOPES=mcp_api,api,refresh_token,offline_access

# --- Salesforce Hosted MCP -------------------------------------------------
# Comma-separated list of MCP endpoints. Every endpoint is connected, discovered
# and called independently, so custom MCP servers activated in your org can sit
# alongside the standard ones. One unreachable endpoint degrades the tool list
# rather than failing the request.
#
# Production / Developer Edition:
#   https://api.salesforce.com/platform/mcp/v1/platform/sobject-all
# Sandbox:
#   https://api.salesforce.com/platform/mcp/v1/sandbox/platform/sobject-all
# My Domain (required for orgs that disabled login.salesforce.com):
#   https://api.salesforce.com/platform/mcp/v1/d/<mydomain>/platform/sobject-all
# A custom MCP server activated in your org:
#   https://api.salesforce.com/platform/mcp/v1/d/<mydomain>/<namespace>/<server>
#
# If two endpoints publish the same tool name, both are exposed with their
# endpoint id prefixed (`sobject_all__find`) rather than one shadowing the other.
SALESFORCE_MCP_URLS=https://api.salesforce.com/platform/mcp/v1/platform/sobject-all

# Deprecated single-endpoint form. Still honoured when SALESFORCE_MCP_URLS is unset.
# SALESFORCE_MCP_URL=

# --- Access policy ---------------------------------------------------------
# Access is delegated to Salesforce by default: the dedicated user's profile,
# permission sets and sharing rules decide which objects and tools are reachable,
# and this application does not second-guess them. That includes tools that
# create, update and delete records, so make the dedicated user read-only in
# Salesforce if the demo should not be able to write.
#
# Objects the assistant may touch. `*` delegates to Salesforce. Set an explicit
# list (e.g. Account,Opportunity) to re-impose an application-side restriction,
# which also re-enables SOQL FROM/subquery/traversal checking and requires every
# tool call to name one of these objects.
SALESFORCE_ALLOWED_OBJECTS=*

# Relationship names permitted as a traversal prefix (`Account.Name`) or as a
# child subquery target. Only consulted when ALLOWED_OBJECTS is restricted.
SALESFORCE_ALLOWED_RELATIONSHIPS=*

# Which discovered MCP tools may be exposed to Gemini. `*` admits everything the
# server offers the dedicated user, which is what lets custom MCP servers work
# without being enumerated here first. Tools are always discovered dynamically.
SALESFORCE_TOOL_ALLOWLIST=*

# Applied after the allowlist, to pin off individual tools without having to
# enumerate every tool you do want. Example: deleteSobjectRecord,deleteRelatedRecord
SALESFORCE_TOOL_BLOCKLIST=

# --- My Day Copilot --------------------------------------------------------
# The /my-day Copilot works out which tool lists appointments, which sets an
# appointment's status and which closes one from the tools' published schemas,
# so no tool name is baked into the code. Set one of these only if an org's
# actions publish too little to infer from, or to force a particular tool.
# Matched as a case-insensitive substring of the tool name; a value that matches
# nothing leaves the capability unresolved rather than guessing.
# COPILOT_TOOL_SCHEDULE=
# COPILOT_TOOL_STATUS=
# COPILOT_TOOL_CLOSE=

# --- Limits ----------------------------------------------------------------
# Not access control: these bound response size and loop length.
MAX_TOOL_ROUNDS=5
MAX_RECORDS=50
MAX_TOOL_RESULT_CHARS=12000
MAX_CONCURRENT_CHATS=2
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_MS=60000
MCP_TIMEOUT_MS=30000

# --- Local setup protection ------------------------------------------------
# Required to reach /api/auth/salesforce. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETUP_SECRET=

# Lets the one-time authorization run on a deployed host instead of localhost.
# Leave unset locally. Only "true" enables it; the authorize route still needs
# SETUP_SECRET, and the callback still depends on the one-shot state it issued.
# ALLOW_REMOTE_SETUP=true

# --- Token storage ---------------------------------------------------------
# Where Salesforce OAuth tokens and the short-lived PKCE state are kept.
#
#   file  (default locally) a git-ignored JSON file. One process only.
#   redis (required on Vercel) Upstash over REST.
#
# Chosen automatically: Redis when its credentials are set, file otherwise.
# Set this only to force one. Forcing redis without credentials fails at
# startup rather than writing somewhere that will not survive.
# TOKEN_STORE=file

# File backend only. Relative to the project root by default.
# TOKEN_STORE_DIR=.local

# Redis backend. Provision Upstash from the Vercel Marketplace (@vercel/kv is
# deprecated) and these are set for you; KV_REST_API_URL / KV_REST_API_TOKEN
# work too, as does either pair with a prefix added by the Vercel integration
# (e.g. MYAPP_KV_REST_API_URL) — the app searches for them.
#
# It must be the HTTPS REST endpoint. REDIS_URL and KV_URL are rediss://
# connection strings the REST client cannot use, and the READ_ONLY token
# cannot write; both are ignored, and a rediss:// URL is reported rather than
# left to fail on the first call.
# A serverless host needs this: its filesystem is read-only, and /tmp is
# per-instance and cleared on a cold start, which would strand both the tokens
# and an in-flight authorization.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Key namespace, so one Redis instance can serve several deployments.
# TOKEN_STORE_PREFIX=salesforce-mcp-poc

# --- Application -----------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Salesforce AI Sales Assistant

# --- My Day dashboard (direct Salesforce REST, no AI) ----------------------
# Appointments come from the ADTTechnicianAppointments Named Query.
# Set to rest_query ONLY as a documented fallback if Named Query execution
# cannot be authorized (same SOQL through the standard REST Query API).
# owner_query: appointments where Owner = the ServiceResource's related User
# (Status = Scheduled), for orgs that link jobs by Owner, not AssignedResource.
# ADT_APPOINTMENT_SOURCE=named_query
# SALESFORCE_API_VERSION=68.0

# Session cookie signing key (falls back to SETUP_SECRET).
# SESSION_SECRET=

# POC ONLY: server-side mapping of sign-in technician IDs to Salesforce
# ServiceResource Ids. The app talks to Salesforce as one shared integration
# user, so this is what scopes a technician's dashboard. There is no password:
# anyone who signs in with a mapped technician ID sees that technician's jobs.
# Replace with real identity before production.
# ADT_DEMO_MODE=true
# ADT_TECHNICIAN_DIRECTORY=[{"technicianId":"TCH-7842","serviceResourceId":"0Hn..."}]

# Used when the technician's Salesforce user has no time zone.
# ADT_DEFAULT_TIMEZONE=America/Chicago

# --- Maps & routing -----------------------------------------------
# Browser map tiles: a public pk.* token, URL-restricted to your domains.
# Optional. Without a token the map uses OpenStreetMap tiles and routing uses
# the public OSRM server + Nominatim (no key; light demo use only).
# ADT_ROUTING_PROVIDER=auto   # auto | mapbox | osrm | none
# OSRM_URL=https://router.project-osrm.org
# NEXT_PUBLIC_MAPBOX_TOKEN=
# Server-side Directions + Geocoding (falls back to the public token).
# MAPBOX_ACCESS_TOKEN=
# mi or km
# ADT_DISTANCE_UNIT=mi
